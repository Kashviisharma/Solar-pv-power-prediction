# Environment Configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NOT be committed.

# -------------------------------------------------------
# NREL API Key (free — register at https://developer.nrel.gov/signup/)
# Required for downloading PVDAQ data via NREL API
# -------------------------------------------------------
NREL_API_KEY=your_api_key_here

# -------------------------------------------------------
# PVDAQ Dataset Configuration
# -------------------------------------------------------
# PVDAQ site ID to download (default: 4 = NREL Golden CO)
PVDAQ_SITE_ID=4

# Year range to download (inclusive)
PVDAQ_START_YEAR=2011
PVDAQ_END_YEAR=2013

# -------------------------------------------------------
# Data paths (defaults — override if needed)
# -------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# -------------------------------------------------------
# Model configuration
# -------------------------------------------------------
MODELS_DIR=models
MODEL_VERSION=1.0

# -------------------------------------------------------
# API configuration
# -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------------------
# Simulation script
# -------------------------------------------------------
# Interval in seconds between simulated sensor readings
SIMULATE_INTERVAL_SECONDS=2
# Number of rows to simulate (0 = all)
SIMULATE_MAX_ROWS=0
